# Supabase (auth/banco/storage) — use a URL e a anon key públicas do seu projeto.
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=coloque_a_anon_key_aqui
