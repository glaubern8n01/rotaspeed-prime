# === RotaSpeed Prime — frontend ===
# Em produção (app nas lojas) use a URL do backend na NUVEM, nunca localhost.
# Backend de teste já no ar (Render, plano free — hiberna após inatividade):
VITE_API_BASE_URL=https://rotaspeed-prime-api.onrender.com
